{
	"schemaVersion": 1,
	"id": "bbslod",
	"version": "${version}",
	"name": "BBS LOD",
	"description": "Distance culling and tiered model simplification for BBS film scenes.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"bbs-addon": ["bbslod.BBSLod"],
		"bbs-client-addon": ["bbslod.BBSLodClient"]
	},
	"mixins": [
		"bbslod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": ">=0.92.1+1.20.1",
		"bbs": ">=2.6.1-1.20.1"
	}
}
